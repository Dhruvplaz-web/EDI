rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions using cryptographically verified auth token custom claims
    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth.token.role;
    }

    function userOrgId() {
      return request.auth.token.orgId;
    }

    function isRole(role) {
      return isAuthenticated() && userRole() == role;
    }

    function isClinicalStaff() {
      return isAuthenticated() && 
        (userRole() in ['clinician', 'clinical_director', 'specialist', 'nurse', 'medical_assistant', 'super_admin']);
    }

    function isPatient() {
      return isAuthenticated() && userRole() == 'patient';
    }

    function isOrgAdmin() {
      return isAuthenticated() && 
        (userRole() in ['clinic_manager', 'billing_admin', 'super_admin']);
    }

    function isSuperAdmin() {
      return isAuthenticated() && userRole() == 'super_admin';
    }

    // Platform Super Admin Emergency Break-Glass:
    // Requires non-expired override record created via server route
    function hasEmergencyBreakGlass(patientId) {
      return isAuthenticated() && 
        isSuperAdmin() && 
        exists(/databases/$(database)/documents/emergency_overrides/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/emergency_overrides/$(request.auth.uid + '_' + patientId)).data.expiresAt > request.time;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: user can read their own profile; org admin can view within org
    // role and orgId are strictly IMMUTABLE for clients (assigned strictly by server Admin SDK)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || (isOrgAdmin() && resource.data.orgId == userOrgId()));
      allow create: if false; // User accounts created via server Admin SDK only
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId || (isOrgAdmin() && resource.data.orgId == userOrgId())) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'orgId'])
      );
      allow delete: if false; // Deletion handled by server Admin SDK
    }

    // Multi-tenant organizations: read by tenant members; managed by platform super_admin or Admin SDK
    // Organization subscription fields (tier, status, seats, stripe ids) are SERVER-ONLY: clients CANNOT write them
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (userOrgId() == orgId || isSuperAdmin());
      allow update: if isOrgAdmin() && resource.data.orgId == userOrgId() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscription', 'tier', 'status', 'seats', 'currentSeats', 'maxSeats', 'stripeCustomerId', 'stripeSubscriptionId'
        ]);
      allow create, delete: if false; // Server Admin SDK only
    }

    // Patients collection (PHI):
    // Super admins have NO default cross-tenant read permission (Principle of Least Privilege)
    match /patients/{patientId} {
      allow read: if isAuthenticated() && (
        (isPatient() && patientId == request.auth.uid) ||
        (isClinicalStaff() && resource.data.orgId == userOrgId()) ||
        (isOrgAdmin() && resource.data.orgId == userOrgId()) ||
        hasEmergencyBreakGlass(patientId)
      );
      allow create: if isClinicalStaff() && request.resource.data.orgId == userOrgId();
      allow update: if isAuthenticated() && (
        (isPatient() && patientId == request.auth.uid && request.resource.data.orgId == resource.data.orgId) ||
        (isClinicalStaff() && resource.data.orgId == userOrgId() && request.resource.data.orgId == resource.data.orgId)
      );
      allow delete: if isOrgAdmin() && resource.data.orgId == userOrgId();
    }

    // Clinical Intakes: IDOR-protected, org-scoped
    match /intakes/{intakeId} {
      allow read: if isAuthenticated() && (
        (isPatient() && resource.data.patientId == request.auth.uid) ||
        (isClinicalStaff() && resource.data.orgId == userOrgId())
      );
      allow create: if isAuthenticated() && (
        (isPatient() && request.resource.data.patientId == request.auth.uid && request.resource.data.orgId == userOrgId()) ||
        (isClinicalStaff() && request.resource.data.orgId == userOrgId())
      );
      allow update: if isClinicalStaff() && 
                       resource.data.orgId == userOrgId() && 
                       request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin() && resource.data.orgId == userOrgId();
    }

    // Sessions & Telemetry: strictly isolated by tenant orgId
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        (isClinicalStaff() && resource.data.orgId == userOrgId()) ||
        (isPatient() && resource.data.patientId == request.auth.uid)
      );
      allow create: if isClinicalStaff() && request.resource.data.orgId == userOrgId();
      allow update: if isClinicalStaff() && 
                       resource.data.orgId == userOrgId() && 
                       request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin() && resource.data.orgId == userOrgId();
    }

    // WebRTC Real-Time Signaling (Audio/Video Consultation Rooms)
    // On create: requires assigned clinician/patient from same tenant orgId
    // On update: forbids changing clinicianId or patientId
    match /calls/{callId} {
      allow read: if isAuthenticated() && 
        (resource.data.clinicianId == request.auth.uid || resource.data.patientId == request.auth.uid);

      allow create: if isAuthenticated() && 
        request.resource.data.orgId == userOrgId() &&
        (request.resource.data.clinicianId == request.auth.uid || request.resource.data.patientId == request.auth.uid);

      allow update: if isAuthenticated() && 
        (resource.data.clinicianId == request.auth.uid || resource.data.patientId == request.auth.uid) &&
        request.resource.data.clinicianId == resource.data.clinicianId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.orgId == resource.data.orgId;

      allow delete: if isOrgAdmin() && resource.data.orgId == userOrgId();

      match /offerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }

      match /answerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Audit logs: Client create strictly DENIED (written only by server Admin SDK)
    // Readable only by that specific organization's admin; immutable
    match /audit_logs/{logId} {
      allow create: if false; // Server Admin SDK only
      allow read: if isOrgAdmin() && resource.data.orgId == userOrgId();
      allow update, delete: if false;
    }

    // Emergency break-glass overrides: created ONLY via server route
    // Clients cannot directly create overrides
    match /emergency_overrides/{overrideId} {
      allow create, update, delete: if false; // Server Admin SDK only
      allow read: if isAuthenticated() && 
        (resource.data.orgId == userOrgId() || isSuperAdmin());
    }

    // Patient Telemetry & AI Consent Records: Immutable compliance store
    match /consent/{consentId} {
      allow read: if isAuthenticated() && (
        (isPatient() && resource.data.patientId == request.auth.uid) ||
        ((isClinicalStaff() || isOrgAdmin()) && resource.data.orgId == userOrgId())
      );
      allow create: if isAuthenticated() && (
        (isPatient() && request.resource.data.patientId == request.auth.uid && request.resource.data.orgId == userOrgId()) ||
        (isClinicalStaff() && request.resource.data.orgId == userOrgId())
      );
      allow update: if isAuthenticated() && (
        (isPatient() && resource.data.patientId == request.auth.uid && 
         request.resource.data.patientId == resource.data.patientId && 
         request.resource.data.orgId == resource.data.orgId) ||
        (isClinicalStaff() && resource.data.orgId == userOrgId() && 
         request.resource.data.orgId == resource.data.orgId)
      );
      allow delete: if false; // Compliance records must never be deleted; revocation is an update
    }
  }
}
