# =============================================================================
# PRAXIS AI / EDI — ENVIRONMENT CONFIGURATION TEMPLATE (INDIA LOCALIZATION)
# =============================================================================
# Copy this file to .env.local and populate with your credentials.
#

# --- Data Residency & Hosting (Mandatory Indian Cloud Regions) ---
# Primary healthcare data region: asia-south1 (Mumbai) or asia-south2 (Delhi)
DATA_RESIDENCY_REGION="asia-south1"
DATA_RESIDENCY_OVERRIDE="false"

# --- Security & Session Authentication ---
# Cryptographic HMAC-SHA256 session secret (must be at least 32 characters in production)
AUTH_SECRET="praxis_dev_secret_key_change_in_production_32bytes!!"

# --- Research Mode & Clinical Decision Support (CDS) Governance ---
# Kept FALSE by default. Requires Institutional Ethics Committee (IEC) approval document
RESEARCH_MODE_ENABLED="false"

# --- Client-Side Firebase Configuration ---
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# --- Server-Side Firebase Admin SDK Configuration ---
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-app-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# --- Razorpay Subscriptions (Indian INR Payments & 18% GST) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# --- Optional Stripe Billing (International Customers Only) ---
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# --- TRAI DLT Notification Metadata (Transaction SMS Verification) ---
DLT_ENTITY_ID="1101XXXXXXXXXXXX"
DLT_HEADER="PRXMED"

# --- App URL Configuration ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
